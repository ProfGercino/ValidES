<?xml version="1.0" encoding="UTF-8"?>

<!--
==============================================================================
Projeto : ValidES
Arquivo : TrianguloView.fxml
Objetivo: Estudo de Caso - Problema do Triângulo
==============================================================================
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.valides.controller.trigonometria.TrianguloController"
            styleClass="painel-modulo">

    <!-- ========================================================= -->
    <!-- CABEÇALHO -->
    <!-- ========================================================= -->
    
	<top>
		<VBox spacing="5">

			<padding>
				<Insets top="10" right="10" bottom="10" left="10"/>
			</padding>
			
			<Label text="Problema do Triângulo"
			       styleClass="titulo-modulo"/>
			
			<Label text="Informe os três lados do triângulo."
			       styleClass="descricao-modulo"/>
			
			<Separator/>

		</VBox>
	</top>

    <!-- ========================================================= -->
    <!-- ÁREA CENTRAL -->
    <!-- ========================================================= -->
    
    <center>

	<VBox spacing="15">

		<padding>
			<Insets top="10" right="10" bottom="10" left="10"/>
		</padding>
		
		<!-- Painel de Entrada -->

		<TitledPane text="Dados de Entrada" collapsible="false">
			<content>
				<GridPane hgap="10" vgap="10">

					<Label text="Lado A:"
						styleClass="label-form"
						GridPane.rowIndex="0"
						GridPane.columnIndex="0"/>
					
					<TextField fx:id="txtLadoA"
						styleClass="field-form"
						GridPane.rowIndex="0"
						GridPane.columnIndex="1"/>
					
					<Label text="Lado B:"
					    styleClass="label-form"
					    GridPane.rowIndex="1"
					    GridPane.columnIndex="0"/>
					
					<TextField fx:id="txtLadoB"
						styleClass="field-form"
					    GridPane.rowIndex="1"
					    GridPane.columnIndex="1"/>
					
					<Label text="Lado C:"
						styleClass="label-form"
					    GridPane.rowIndex="2"
					    GridPane.columnIndex="0"/>
					
					<TextField fx:id="txtLadoC"
						styleClass="field-form"
					    GridPane.rowIndex="2"
					    GridPane.columnIndex="1"/>

				</GridPane>
			</content>
		</TitledPane>
		
		 <!-- Painel de Resultado -->

		<TitledPane text="Resultado" collapsible="false">
		    <content>
		        <TextArea fx:id="txtResultado"
		                  editable="false"
		                  prefHeight="180"
		                  wrapText="true"/>
		    </content>
		</TitledPane>
	</VBox>

    </center>

    <!-- ========================================================= -->
    <!-- BARRA DE AÇÕES -->
    <!-- ========================================================= -->
    
    <bottom>
		<HBox spacing="10" styleClass="barra-acoes">

			<padding>
				<Insets top="10" right="10" bottom="10" left="10"/>
			</padding>
	
			<Button
				fx:id="btnExecutar"
				text="Executar"
				onAction="#executar"
				styleClass="botao-principal"/>
	
	        <Button
	        	fx:id="btmLimpar"
	        	text="Limpar"
				onAction="#limpar"
				styleClass="botao-secundario"/>
	
	        <Region HBox.hgrow="ALWAYS"/>
	
	        <Button
	        	fx:id="btnFechar"
	        	text="Fechar"
				onAction="#fechar"
				styleClass="botao-secundario"/>

        </HBox>
    </bottom>

</BorderPane>