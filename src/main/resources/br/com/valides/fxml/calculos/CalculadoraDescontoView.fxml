<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="br.com.valides.controller.calculos.CalculadoraDescontoController"
    stylesheets="@../../styles/application.css">

    <!-- ===================================================== -->
    <!-- CABEÇALHO                                              -->
    <!-- ===================================================== -->

    <top>

        <VBox spacing="10">

            <padding>
                <Insets top="15" right="15" bottom="10" left="15"/>
            </padding>

            <Label
                text="Calculadora de Desconto"
                styleClass="titulo-tela"/>

        </VBox>

    </top>

    <!-- ===================================================== -->
    <!-- ÁREA CENTRAL                                           -->
    <!-- ===================================================== -->

    <center>

        <VBox spacing="15">

            <padding>
                <Insets top="10" right="15" bottom="10" left="15"/>
            </padding>

            <!-- Painel de Entrada -->

            <GridPane hgap="10" vgap="10">

                <Label
                    text="Valor da Compra:"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="0"/>

                <TextField
                    fx:id="txtValorCompra"
                    promptText="Informe o valor da compra"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="1"/>

                <Label
                    text="Percentual de Desconto:"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="0"/>

                <TextField
                    fx:id="txtPercentualDesconto"
                    promptText="Informe o percentual (%)"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="1"/>

            </GridPane>

            <!-- Painel de Resultado -->

            <Label text="Resultado"/>

            <TextArea
                fx:id="txtResultado"
                editable="false"
                prefHeight="220"
                wrapText="true"/>

        </VBox>

    </center>

    <!-- ===================================================== -->
    <!-- BARRA DE AÇÕES                                         -->
    <!-- ===================================================== -->

    <bottom>

        <HBox spacing="10">

            <padding>
                <Insets top="10" right="15" bottom="15" left="15"/>
            </padding>

            <Button
                text="Executar"
                onAction="#executar"/>

            <Button
                text="Limpar"
                onAction="#limpar"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button
                text="Fechar"
                onAction="#fechar"/>

        </HBox>

    </bottom>

</BorderPane>