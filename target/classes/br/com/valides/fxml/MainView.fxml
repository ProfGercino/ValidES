<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.valides.controller.MainController">

<!--- Menu Principal -->
	<top>

        <MenuBar>
        
			<Menu text="Trigonometria">
				<MenuItem 
					text="Problema do Triângulo"
					onAction="#abrirTriangulo"/>
				<MenuItem text="Lei dos Senos"/>
				<MenuItem text="Lei dos Cossenos"/>
				<MenuItem text="Classificação de Triângulos"/>                

			</Menu>

            <Menu text="Conversões">
                <MenuItem 
                	text="Conversão de Datas"
                	onAction="#abrirConversaoData"/>
                <MenuItem text="Conversão de Temperatura"/>
                <MenuItem text="Conversão de Distâncias"/>
                <MenuItem text="Conversão de Moedas"/>                                
               
            </Menu>

            <Menu text="Cálculos">
                <MenuItem
					text="Calculadora de Desconto"
					onAction="#abrirCalculadoraDesconto"/>
                <MenuItem text="Calculadora de INSS"/>
                <MenuItem text="Calculadora de Juros"/>
                <MenuItem text="Calculadora de Média"/>                
            </Menu>
            
            <Menu text="Validadores">
                <MenuItem
					text="Validador de CPF"
					onAction="#abrirValidadorCPF"/>
                <MenuItem text="Validador de CNPJ"/>
                <MenuItem text="Validador de CEP"/>
                <MenuItem text="Validador de E-mail"/>                
            </Menu>            
            
            <Menu text="Sistema">
                <MenuItem text="Sair" onAction="#encerrarSistema"/>
            </Menu>

        </MenuBar>

	</top>

<!--- Área MDI -->
    <center>

		<AnchorPane fx:id="desktopPane" styleClass="desktop-pane"/>

    </center>

<!--- Barra de Status -->
    <bottom>
		<BorderPane>
			<left>
	 	       <Label fx:id="lblUsuario"/>
			</left>
	
			<center>
		        <Label fx:id="lblStatus"
					style="-fx-font-weight: bold;"/>
			</center>
		</BorderPane>
    </bottom>

</BorderPane>